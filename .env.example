# IQ Option Credentials
IQ_OPTION_EMAIL=your_iq_option_email@example.com
IQ_OPTION_PASSWORD=your_iq_option_password

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
