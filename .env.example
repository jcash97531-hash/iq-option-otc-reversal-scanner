# Scanner Configuration
ASSETS=EURUSD,GBPUSD,USDJPY
TIMEFRAME=1  # in minutes (1, 5, 15, 30, 60)
CHECK_INTERVAL=10  # seconds between candle checks
REVERSAL_LENGTH=6  # consecutive candles in one direction
